{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@crew-credits": ["./shared/crew-credits"],
      "@crew-credits/*": ["./shared/crew-credits/*"],
      "@display-titles": ["./shared/display-titles"],
      "@display-titles/*": ["./shared/display-titles/*"],
      "@phrase-book": ["./shared/phrase-book"],
      "@phrase-book/*": ["./shared/phrase-book/*"],
      "@ai-translation": ["./shared/ai-translation"],
      "@ai-translation/*": ["./shared/ai-translation/*"],
      "@video-url": ["./shared/video-url"],
      "@video-url/*": ["./shared/video-url/*"],
      "@client-logos": ["./shared/client-logos"],
      "@client-logos/*": ["./shared/client-logos/*"],
      "@trash-retention": ["./shared/trash-retention"],
      "@trash-retention/*": ["./shared/trash-retention/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "scripts/migration"]
}
