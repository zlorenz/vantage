{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@crew-credits": ["../shared/crew-credits"],
      "@crew-credits/*": ["../shared/crew-credits/*"],
      "@display-titles": ["../shared/display-titles"],
      "@display-titles/*": ["../shared/display-titles/*"],
      "@phrase-book": ["../shared/phrase-book"],
      "@phrase-book/*": ["../shared/phrase-book/*"],
      "@ai-translation": ["../shared/ai-translation"],
      "@ai-translation/*": ["../shared/ai-translation/*"],
      "@video-url": ["../shared/video-url"],
      "@video-url/*": ["../shared/video-url/*"],
      "@client-logos": ["../shared/client-logos"],
      "@client-logos/*": ["../shared/client-logos/*"],
      "@trash-retention": ["../shared/trash-retention"],
      "@trash-retention/*": ["../shared/trash-retention/*"],
      "@studio-overlay-z": ["../shared/studio-overlay-z"],
      "@studio-overlay-z/*": ["../shared/studio-overlay-z/*"],
      "@carousel-ratios": ["../shared/carousel-ratios"],
      "@carousel-ratios/*": ["../shared/carousel-ratios/*"],
      "@media-tags": ["../shared/media-tags"],
      "@media-tags/*": ["../shared/media-tags/*"],
      "@video-formats": ["../shared/video-formats"],
      "@video-formats/*": ["../shared/video-formats/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/crew-credits/**/*.ts",
    "../shared/display-titles/**/*.ts",
    "../shared/phrase-book/**/*.ts",
    "../shared/ai-translation/**/*.ts",
    "../shared/video-url/**/*.ts",
    "../shared/client-logos/**/*.ts",
    "../shared/trash-retention/**/*.ts",
    "../shared/studio-overlay-z/**/*.ts",
    "../shared/carousel-ratios/**/*.ts",
    "../shared/media-tags/**/*.ts",
    "../shared/video-formats/**/*.ts",
    "../messages/**/*.json",
    "../src/lib/campaign-brief-fields.ts",
    "../src/lib/campaign-brief-i18n.ts"
  ]
}
