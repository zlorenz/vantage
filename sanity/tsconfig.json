{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@crew-credits": ["../shared/crew-credits"],
      "@crew-credits/*": ["../shared/crew-credits/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/crew-credits/**/*.ts"]
}
