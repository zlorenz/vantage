                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "A9aksN",
                      "name": "Eyebrow",
                      "fill": "#645A5A",
                      "content": "MORE ABOUT VANTAGE",
                      "fontFamily": "Mona Sans",
                      "fontSize": 10,
                      "fontWeight": "700",
                      "letterSpacing": 1.4
                    },
                    {
                      "type": "text",
                      "id": "L5IbBL",
                      "name": "H2",
                      "fill": "#000000",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "GLOBAL COMMERCIAL FILM PRODUCTION FOR AMBITIOUS BRANDS",
                      "lineHeight": 1.35,
                      "fontFamily": "Special Gothic Expanded One",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Pkokc",
                      "name": "P1",
                      "fill": "#645A5A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Vantage is a boutique production company based in Ho Chi Minh City, delivering full-service pre-production, on-location shooting, and post across Vietnam and Southeast Asia. We work with global agencies and direct brand clients on commercials, branded content, and long-form work.",
                      "lineHeight": 1.6,
                      "fontFamily": "Mona Sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "u02ljj",
                      "name": "H3",
                      "fill": "#000000",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "WHY FILM IN VIETNAM",
                      "lineHeight": 1.4,
                      "fontFamily": "Special Gothic Expanded One",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nxG32",
                      "name": "P2",
                      "fill": "#645A5A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Diverse locations from the Mekong Delta to the karst peaks of Hạ Long Bay, a deep bench of experienced local crews, streamlined permit workflows, and cost efficiencies that stretch a production budget without cutting corners. Frequent shoot regions include Hồ Chí Minh City, Đà Nẵng, Hội An, Ninh Bình, and Sa Pa.",
                      "lineHeight": 1.6,
                      "fontFamily": "Mona Sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Oj1gR",
                      "name": "H3b",
                      "fill": "#000000",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "PRODUCTION SERVICES",
                      "lineHeight": 1.4,
                      "fontFamily": "Special Gothic Expanded One",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "UL2jH",
                      "name": "P3",
                      "fill": "#645A5A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Pre-production and creative development, casting and talent, location scouting and permitting, on-set production management, camera and lighting packages, art department, and post — editorial, color, sound design, and finishing — all delivered through a single producer contact per project.",
                      "lineHeight": 1.6,
                      "fontFamily": "Mona Sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "SCBo1",
                      "name": "H3c",
                      "fill": "#000000",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "SHOT IN VIETNAM",
                      "lineHeight": 1.4,
                      "fontFamily": "Special Gothic Expanded One",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "k4ECfO",
                      "name": "P4",
                      "fill": "#645A5A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Recent clients include Mammotion, Govee, Ogilvy, Wieden+Kennedy Tokyo, Publicis, and Grey Group — spanning tech launch spots, tourism campaigns, and branded documentary work.",
                      "lineHeight": 1.6,
                      "fontFamily": "Mona Sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "j2hbR",
              "name": "Component Note",
              "fill": "#645A5A",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Type scale intentionally quiet — H2 20/1.35, H3 15/1.4, body 13/1.6 — never breaks into display-face territory.  • All headings sentence case Mona Sans Medium (weight 500), no uppercase, no letter-spacing.  • Body copy in dark-gray (#645A5A) not black, so it reads as secondary reference material at a glance.  • Wrap in the standard Light Section variant surface (white bg, black text tokens available) — no dedicated bg color needed.  • Server-rendered HTML, not client-fetched — required for the SEO value this content preserves.",
              "lineHeight": 1.5,
              "fontFamily": "Mona Sans",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
