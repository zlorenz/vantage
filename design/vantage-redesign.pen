                  "fill": "#000000",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Motion supports the story; it never decorates for its own sake.",
                  "lineHeight": 1.4,
                  "fontFamily": "Mona Sans",
