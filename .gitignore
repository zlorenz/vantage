# --------------------------------------------------
# Dependencies
# --------------------------------------------------

node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --------------------------------------------------
# Environment / secrets — NEVER commit these
# --------------------------------------------------

.env
.env.*
!.env.example
!.env.*.example
*.pem

# --------------------------------------------------
# Next.js
# --------------------------------------------------

.next/
out/
build/
coverage/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --------------------------------------------------
# Sanity (studio also has its own .gitignore)
# --------------------------------------------------

.sanity/

# --------------------------------------------------
# Logs / debug
# --------------------------------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --------------------------------------------------
# OS / editor junk
# --------------------------------------------------

.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --------------------------------------------------
# Migration scratch (regenerable / downloaded)
# --------------------------------------------------

migration-data/blog-zh-html/

# --------------------------------------------------
# WordPress legacy (local reference only — not part of Next app)
# --------------------------------------------------

# Core
/wp-admin/
/wp-includes/
/xmlrpc.php
/wp-*.php
/index.php
/license.txt
/readme.html
wp-config.php
.htaccess

# Media, cache, backups
/wp-content/uploads/
/wp-content/cache/
/wp-content/wpvividbackups/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/

# Plugins / themes — keep local WP tree out of new commits
# (already-tracked child-theme files stay tracked until removed)
/wp-content/plugins/
/wp-content/themes/

# Sanity dataset exports
*.tar.gz

# Sanity Functions
functions/**/.env*
functions/**/.build/
functions/**/node_modules/

# Local scratch (dataset exports, function fixtures)
tmp/
.vercel
.env*
design/assets/
